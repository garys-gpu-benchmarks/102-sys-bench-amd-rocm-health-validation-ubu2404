  {
    "field_name": "Workload Name",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "ROCm System Validation (clocks, temp, etc.)"
  },
  {
    "field_name": "GPU Vendor",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "AMD"
  },
  {
    "field_name": "Repo Name",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sys-bench-amd-rocm-health-validation-ubu2404"
  },
  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Analyze GPU ROCm runtime environment health"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates a single telemetry snapshot. ECC/RAS/clock yaml flags are not implemented as separate probes"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: dmesg GPU fault count (dmesg_gpu_fault_count); #2: GPU temperature (gpu_temperature_c); #3: PCIe link width (pcie_link_width_lanes); #4: PCIe link speed (pcie_link_speed_gt_s); #5: HSA agents visible (hsa_agents_visible_count)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run dmesg, rocm-smi --showtemp --showbus --showclocks --showpower, amd-smi metric, and rocminfo"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run dmesg, rocm-smi temperature/bus/clock/power queries, amd-smi metric, and rocminfo, then parse junction temp, PCIe width/speed, HSA agents, and fault-keyword counts, to measure ROCm GPU health. DCGM is not used"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Scan dmesg for GPU fault keywords and query rocm-smi temperature, bus, clocks, and power, amd-smi metric, and rocminfo once. Regex-extract junction temperature, PCIe width and speed, HSA agent count, and fault counts into one summary row. DCGM is not used"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Takes one ROCm health snapshot from dmesg, rocm-smi, amd-smi, and rocminfo. Yaml pcie_check, clock_check, temperature_check, power_check, ecc_check, ras_check, firmware_version_check, hsa_agent_check, queue_check, and dmesg_check are documented; the collector always records dmesg faults, junction temp, HSA agent count, PCIe width/speed, and queue count. output_format: csv"
  },
  {
    "field_name": "Execution Domain",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validation / Correctness"
  },
  {
    "field_name": "Workload Category",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "System Validation & Reliability"
  },
  {
    "field_name": "Workload Type",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Test"
  },
  {
    "field_name": "Target Hardware",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "GPU"
  },
  {
    "field_name": "GPU Model",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "MI300X"
  },
  {
    "field_name": "Raw Output Format",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "CSV aggregate plus dmesg.txt"
  },
  {
    "field_name": "Primary Record Granularity",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "one aggregate CSV row, duplicated so the harness sees two samples"
  },
  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,status,dmesg_gpu_fault_count,gpu_temperature_c,hsa_agents_visible_count,pcie_link_width_lanes,pcie_link_speed_gt_s,queues_available_count,error_message\n0,ok,0,40,1,16,32,1,"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --pcie-check true --clock-check true --temperature-check true --power-check true --ecc-check true --ras-check true --firmware-version-check true --hsa-agent-check true --queue-check true --dmesg-check true --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --pcie-check true --clock-check true --temperature-check true --power-check true --ecc-check true --ras-check true --firmware-version-check true --hsa-agent-check true --queue-check true --dmesg-check true --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --pcie-check true --clock-check true --temperature-check true --power-check true --ecc-check true --ras-check true --firmware-version-check true --hsa-agent-check true --queue-check true --dmesg-check true --output-format csv"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "dmesg_gpu_fault_count, gpu_temperature_c, hsa_agents_visible_count, pcie_link_width_lanes, pcie_link_speed_gt_s, queues_available_count"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "status=ok when rocminfo reports at least one GPU agent, and the threshold gates accept the parsed sample"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Unparsed temperature, link width, and link speed stay blank. dmesg_gpu_fault_count counts every dmesg line matching page fault, gpu hang, hardware reset, or uncorrectable. A single sample row is written twice"
  },
