  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,status,dmesg_gpu_fault_count,gpu_temperature_c,hsa_agents_visible_count,pcie_link_width_lanes,pcie_link_speed_gt_s,queues_available_count,window_new_dmesg_fault_count,sample_elapsed_s,sample_gpu_temperature_c,sample_hsa_agents_visible_count,sample_pcie_link_width_lanes,sample_pcie_link_speed_gt_s,error_message\n0,ok,0,41,1,16,32,1,0,0.0,40,1,16,32,"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "dmesg_gpu_fault_count, gpu_temperature_c, hsa_agents_visible_count, pcie_link_width_lanes, pcie_link_speed_gt_s, queues_available_count, window_new_dmesg_fault_count, sample_elapsed_s, sample_gpu_temperature_c, sample_hsa_agents_visible_count, sample_pcie_link_width_lanes, sample_pcie_link_speed_gt_s"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "gpu_temperature_c is the peak, pcie_link_width_lanes and pcie_link_speed_gt_s the narrowest and slowest AMD GPU link, and hsa_agents_visible_count the fewest agents seen over the window, repeated on every row. sample_* columns hold each reading. dmesg_gpu_fault_count counts dmesg lines since boot matching page fault, gpu hang, hardware reset, or uncorrectable. Unparsed values stay blank"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "status=ok on every row: at least expected_gpu_count HSA GPU agents stayed visible, every AMD GPU link stayed at least min_pcie_link_width lanes, and the threshold gates accept the parsed sample"
  },
