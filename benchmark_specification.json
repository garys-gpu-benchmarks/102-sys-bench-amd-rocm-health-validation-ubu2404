  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates HSA GPU agent visibility against expected_gpu_count, PCIe link width against min_pcie_link_width, PCIe speed, peak temperature over the monitor window, and dmesg GPU fault mentions"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run amd-smi metric, rocminfo, and sysfs PCIe link files once per second for monitor_duration_sec, and dmesg at the start and end, then report peak junction temperature, the narrowest PCIe link, the fewest HSA GPU agents seen, and fault-keyword counts, to measure ROCm GPU health. DCGM is not used"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Poll amd-smi metric, rocminfo, and every AMD GPU's sysfs PCIe link files once per second for monitor_duration_sec. Keep the peak temperature, the narrowest link width and slowest speed, and the fewest HSA GPU agents seen. Fail when fewer than expected_gpu_count agents or a link narrower than min_pcie_link_width appears. DCGM is not used"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Samples ROCm GPU health once per second from amd-smi, rocminfo, and sysfs, and counts dmesg GPU fault lines since boot. monitor_duration_sec: seconds to keep sampling; temperature is the peak over the window (smoke 5 / baseline 200 / extended 580). expected_gpu_count: fewest HSA GPU agents that must stay visible; fewer fails the run (1). min_pcie_link_width: narrowest acceptable PCIe link, in lanes, on every AMD GPU; narrower fails the run (16)"
  },
  {
    "field_name": "Execution Domain",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validation / Correctness"
  },
